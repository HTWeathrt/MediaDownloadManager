<Window x:Class="MediaDownloadManager.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Sign in to YouTube"
        Width="980" Height="720"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="10,8" Background="#F3F6FB" BorderBrush="#D9E0EC" BorderThickness="0,0,0,1">
      <DockPanel>
        <Button DockPanel.Dock="Right" x:Name="DoneButton" Content="Done - save cookies"
                Padding="14,4" Margin="12,0,0,0" Click="Done_Click"/>
        <TextBlock x:Name="HintText" VerticalAlignment="Center" TextWrapping="Wrap"
                   Text="Sign in to your Google account, then click Done. Cookies are saved for yt-dlp."/>
      </DockPanel>
    </Border>
    <wv2:WebView2 x:Name="Web"/>
  </DockPanel>
</Window>
