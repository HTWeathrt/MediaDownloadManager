<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon />
    <AssemblyName>MediaDownloadManager</AssemblyName>
    <RootNamespace>MediaDownloadManager</RootNamespace>
    <Version>0.2.0</Version>
    <Authors>TextTo_Voice</Authors>
    <Description>FDM-style media downloader for YouTube, TikTok, Instagram, Facebook (yt-dlp)</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
  </ItemGroup>

</Project>
