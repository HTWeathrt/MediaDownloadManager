<Window x:Class="MediaDownloadManager.AddUrlsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add downloads" Height="520" Width="700"
        MinHeight="400" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBgBrush}"
        FontFamily="Segoe UI" FontSize="13"
        FocusManager.FocusedElement="{Binding ElementName=UrlBox}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="2*" MinHeight="70"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="3*" MinHeight="90"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Label Grid.Row="0" Target="{Binding ElementName=UrlBox}" Padding="0,0,0,4"
           Content="_Paste or type links (one per line, or a curl command):"/>

    <TextBox Grid.Row="1" x:Name="UrlBox" AcceptsReturn="True" TextWrapping="NoWrap"
             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
             VerticalContentAlignment="Top" TextChanged="UrlBox_TextChanged"/>

    <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" ResizeDirection="Rows"/>

    <GroupBox Grid.Row="3" Header="Detected links">
      <Grid>
        <DataGrid x:Name="PreviewGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0" SelectionMode="Single" BorderThickness="0">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="90"/>
            <DataGridTextColumn Header="Link" Binding="{Binding Url}" Width="*"/>
            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130"/>
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="EmptyText" Margin="12" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                   Text="No links yet.&#x0a;Supported: YouTube, TikTok, Instagram, Facebook, torrent / magnet, HLS (.m3u8), curl commands, direct http(s) links."/>
      </Grid>
    </GroupBox>

    <DockPanel Grid.Row="4" Margin="0,10,0,0" LastChildFill="False">
      <TextBlock x:Name="CountText" Text="No links" DockPanel.Dock="Left" VerticalAlignment="Center"/>
      <Button Content="Cancel" DockPanel.Dock="Right" MinWidth="80" Padding="8,3" Margin="6,0,0,0" IsCancel="True"/>
      <Button x:Name="AddStartBtn" Content="Add &amp; _Start" DockPanel.Dock="Right" MinWidth="110" Margin="6,0,0,0"
              Style="{StaticResource PrimaryBtn}"
              IsDefault="True" IsEnabled="False" Click="AddStart_Click"/>
      <Button x:Name="AddPausedBtn" Content="Add Pa_used" DockPanel.Dock="Right" MinWidth="90" Padding="8,3" Margin="6,0,0,0"
              IsEnabled="False" Click="AddPaused_Click"/>
      <Button Content="C_lear" DockPanel.Dock="Right" MinWidth="60" Padding="8,3" Margin="6,0,0,0" Click="Clear_Click"/>
      <Button Content="Paste _clipboard" DockPanel.Dock="Right" MinWidth="110" Padding="8,3" Click="Paste_Click"/>
    </DockPanel>
  </Grid>
</Window>
